# ==============================================================================
# IFC ACADEMY - PRODUCTION ENVIRONMENT VARIABLES MANIFEST
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE SECRETS (Never exposed to browser - Vercel / Cloud Run Secrets)
# ------------------------------------------------------------------------------

# Database (Supabase PostgreSQL Connection)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Security & Session Authentication
JWT_SECRET=your_super_strong_random_jwt_secret_key_here
SESSION_SECRET=your_super_strong_session_secret_key_here

# Vercel Automated Cron Security
CRON_SECRET=your_vercel_cron_secret_token_here

# Google Cloud Service Account (Google Sheets & Google Drive Direct Backup)
GOOGLE_SERVICE_ACCOUNT_EMAIL=ifc-academy-sa@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your_google_sheets_spreadsheet_id_here
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_backup_folder_id_here

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE VARIABLES (Safe for browser - prefixed with VITE_)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_APP_NAME="IFC ACADEMY"
VITE_CURRENCY="EGP"
